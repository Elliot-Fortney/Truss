{
  "name": "truss-cdk",
  "version": "0.0.0",
  "description": "Open a TypeScript CDK app as an editable Design",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "truss": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets/aws-architecture-icons/NOTICE",
    "assets/tabler-icons/LICENSE",
    "assets/tabler-icons/NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "e2e": "playwright test",
    "record-fixture": "node scripts/record-fixture.ts"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "dependency-cruiser": "18.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-cdk/toolkit-lib": "1.44.1",
    "@typescript/typescript6": "6.0.2",
    "ws": "8.22.0"
  }
}
